# Copy to apps/agent/.env and fill in. NEVER commit the real .env.
# Phase 0 defaults run the full pipeline with no secrets (CHAIN_MODE=mock).

# --- Model service ---------------------------------------------------------
MODEL_URL=http://127.0.0.1:8000
# service = call the FastAPI model; fallback = use a local heuristic (offline demo)
MODEL_MODE=service

# --- Market source ---------------------------------------------------------
# fixture    = apps/agent/fixtures/markets.json (deterministic, default)
# espn       = REAL matches + bookmaker odds via ESPN (no key, geo-unrestricted)
# polymarket = Polymarket Gamma API (only where it is not geo-blocked)
MARKETS_SOURCE=fixture
# ESPN league code, e.g. fifa.world, eng.1, esp.1, ita.1, ger.1, uefa.champions
ESPN_LEAGUE=fifa.world
ESPN_MAX_MARKETS=8
ESPN_API=https://site.api.espn.com
# Legacy Polymarket toggle (kept for compatibility)
POLYMARKET_MODE=fixture
POLYMARKET_API=https://gamma-api.polymarket.com

# --- Outcome source (for resolve) ------------------------------------------
# fixture = apps/agent/fixtures/outcomes.json ; espn = real results (winner)
OUTCOMES_SOURCE=fixture

# --- Chain (Polygon Amoy) --------------------------------------------------
# mock = simulate the commit tx locally (no key needed, default)
# amoy = send a real commitPrediction tx to the deployed contract
CHAIN_MODE=mock
RPC_URL=https://rpc-amoy.polygon.technology
PRIVATE_KEY=
CONTRACT_ADDRESS=

# --- Storage ---------------------------------------------------------------
# mock = write run output to the local state file the dashboard reads
# supabase = persist to Supabase (requires URL + service key)
STORE_MODE=mock
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Strategy --------------------------------------------------------------
# Commit only when |edge| >= this (basis points). 500 = 0.05.
EDGE_THRESHOLD_BPS=500
